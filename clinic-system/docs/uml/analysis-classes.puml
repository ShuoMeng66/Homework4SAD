@startuml analysis-classes
' 核心分析类 — 依据报告 PDF 第6章、表16~18
' 边界类/控制类/实体类按课件三栏表示；主键、外键、DB访问操作不列入
skinparam shadowing false
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #1A73C4
  ArrowColor #1A73C4
}
stereotype "boundary" as boundary
stereotype "control" as control
stereotype "entity" as entity

class "前台接口" <<boundary>>
class "医生接口" <<boundary>>
class "收费接口" <<boundary>>
class "负责人接口" <<boundary>>
class "支付服务接口" <<boundary>>
class "技工所接口" <<boundary>>
class "消息服务接口" <<boundary>>

class "登记预约控制" <<control>>
class "录入收费控制" <<control>>
class "录入义齿订单控制" <<control>>
class "查询统计与提醒控制" <<control>>

class "患者" <<entity>> {
  +姓名
  +电话
  +出生日期
  +重要提示
  +核对身份()
}
class "预约" <<entity>> {
  +开始时间
  +结束时间
  +阶段
  +确认()
  +改约()
  +取消()
  +登记到诊()
  +汇总履约()
}
class "医生" <<entity>>
class "诊室" <<entity>>
class "预约变更" <<entity>> {
  +原时段
  +新时段
  +原因
  +操作人
}
class "诊疗" <<entity>> {
  +主诉
  +诊断
  +处理记录
}
class "收费单" <<entity>> {
  +折扣
  +应收
  +已收
  +欠款
  +拟定()
  +计算应收()
  +应用支付结果()
  +汇总回收()
}
class "收费明细" <<entity>>
class "收费项目" <<entity>>
class "支付" <<entity>> {
  +请求号
  +结果
  +金额
  +登记尝试()
  +确认结果()
}
class "欠款" <<entity>> {
  /余额
}
class "义齿订单" <<entity>> {
  +订单号
  +状态
  +承诺日期
  +保存草稿()
  +发送()
  +受理回执()
  +登记试戴()
  +确认交货()
  +申请返工()
}
class "产品" <<entity>>
class "技工所" <<entity>>
class "订单牙位" <<entity>>
class "订单进展" <<entity>>
class "附件" <<entity>>
class "提醒" <<entity>> {
  +计划时间
  +收件人
  +发送结果
  +排定()
  +判断到期()
  +确认发送()
}

"患者" "1" -- "*" "预约"
"患者" "1" -- "*" "诊疗"
"预约" "1" -- "0..1" "诊疗"
"预约" "1" -- "*" "预约变更"
"预约" "*" -- "1" "医生"
"预约" "*" -- "1" "诊室"
"诊疗" "1" -- "*" "收费单"
"收费单" "1" *-- "*" "收费明细"
"收费单" "1" -- "*" "支付"
"收费单" "1" -- "0..1" "欠款"
"收费明细" "*" -- "1" "收费项目"
"诊疗" "1" -- "*" "义齿订单"
"义齿订单" "*" -- "1" "产品"
"义齿订单" "*" -- "1" "技工所"
"义齿订单" "1" *-- "*" "订单牙位"
"义齿订单" "1" *-- "*" "订单进展"
"义齿订单" "1" *-- "*" "附件"
"提醒" "*" -- "0..1" "预约"
"提醒" "*" -- "0..1" "义齿订单"

"前台接口" ..> "登记预约控制"
"收费接口" ..> "录入收费控制"
"医生接口" ..> "录入义齿订单控制"
"负责人接口" ..> "查询统计与提醒控制"
"登记预约控制" ..> "患者"
"登记预约控制" ..> "预约"
"录入收费控制" ..> "收费单"
"录入义齿订单控制" ..> "义齿订单"
"查询统计与提醒控制" ..> "预约"
"查询统计与提醒控制" ..> "收费单"
"查询统计与提醒控制" ..> "义齿订单"
"查询统计与提醒控制" ..> "提醒"
"支付服务接口" ..> "支付"
"技工所接口" ..> "订单进展"
"消息服务接口" ..> "提醒"
@enduml
