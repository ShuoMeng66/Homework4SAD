hide circle
skinparam style strictuml
skinparam defaultFontName "Microsoft YaHei", "PingFang SC", Arial, sans-serif
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 60
skinparam ranksep 75
skinparam class {
  BorderColor #2C3E50
  BorderThickness 1.2
  FontSize 12
  AttributeFontSize 11
}
skinparam arrow {
  Color #2C3E50
  Thickness 1.1
  FontSize 11
}

class "前台接口" as UI <<boundary>> #E0F2FE {
  --
  + 接收请求(输入) : void
  + 反馈结果(结果) : void
}
class "登记预约控制" as CTRL <<control>> #DCFCE7 {
  --
  + 登记预约(要求) : void
}
class "消息服务接口" as EXT <<boundary>> #E0F2FE {
  --
  + 发送预约通知(预约) : void
  + 接收发送结果(回执) : void
}
UI .right.> CTRL
CTRL .right.> EXT

class "患者" as patient <<entity>> #FFFFFF {
  - 姓名 : string
  - 出生日期 : Date
  - 联系方式 : string
  - 重要提示 : string
  --
  + 识别或登记(身份资料) : 患者
  + 更新联系方式(联系方式) : void
  + 核对身份(身份资料) : bool
}
class "预约" as appointment <<entity>> #FFFFFF {
  - 开始时间、结束时间 : DateTime
  - 预约类型、主诉 : string
  - 当前阶段 : 预约阶段
  --
  + 确认(预约要求) : 预约结果
  + 改约(新时段、原因) : void
  + 取消(原因) : void
  + 登记到诊() : void
  + 汇总履约(期间) : 统计结果
}
class "医生" as doctor <<entity>> #FFFFFF {
  - 姓名 : string
  - 可接诊 : bool
  --
  + 检查可接诊(时段) : bool
  + 列出有效预约(时段) : 预约[*]
}
class "诊室" as room <<entity>> #FFFFFF {
  - 名称 : string
  - 可使用 : bool
  --
  + 检查可使用(时段) : bool
  + 列出有效预约(时段) : 预约[*]
}
class "诊疗" as encounter <<entity>> #FFFFFF {
  - 发生时间 : DateTime
  - 主诉、诊断、处理意见 : string
  --
  + 记录诊疗(诊疗内容) : void
  + 确认可开单() : bool
  + 开立收费单(项目集合) : 收费单
}
class "治疗计划" as plan <<entity>> #FFFFFF {
  - 计划编号 : string
  - 主诉、诊断 : string
  - 阶段 : 计划阶段
  - 报价合计 : Money
  - 确认时间、关闭时间 : DateTime
  --
  + 添加计划项(牙位、项目、期次) : 计划项
  + 确认(患者同意) : void
  + 关闭() : void
  + 汇总进度() : 进度
}
class "计划项" as item <<entity>> #FFFFFF {
  - 牙位 : string
  - 项目名称、期次 : string
  - 数量、单价 : number
  - 状态 : 计划项状态
  - 执行时间 : DateTime
  --
  + 标记执行(就诊) : void
  + 关联收费(收费单) : void
  + 关联技工单(订单) : void
}
class "预约变更" as history <<entity>> #FFFFFF {
  - 原时段、新时段 : 时段
  - 变更时间 : DateTime
  - 原因、操作人 : string
  --
  + 记载变更(变更内容) : void
}

patient "1" -right- "0..*" appointment
patient "1" -[norank]- "0..*" encounter
appointment "0..*" -[norank]- "1" doctor
appointment "0..*" -[norank]- "1" room
encounter "0..*" -right- "1" doctor
appointment "1" *-right- "0..*" history
appointment "0..1" -[norank]- "0..1" encounter
CTRL .[norank].> patient
CTRL .[norank].> appointment

UI -[hidden]right- CTRL
CTRL -[hidden]right- EXT
patient -[hidden]right- appointment
appointment -[hidden]right- history
encounter -[hidden]right- doctor
doctor -[hidden]right- room
UI -[hidden]down- patient
patient -[hidden]down- encounter
patient "1" -right- "0..*" plan
plan "1" *-right- "0..*" item
item "0..*" -[norank]- "0..1" encounter
encounter "0..*" -[norank]- "0..1" plan
