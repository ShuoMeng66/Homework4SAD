@startuml
!include _style.puml
hide circle
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
class "医生接口" as UI <<boundary>> #DDF0F2 {
  --
  + 接收请求(输入) : void
  + 反馈结果(结果) : void
}
class "录入义齿订单控制" as CTRL <<control>> #E5EFE2 {
  --
  + 录入订单(修复要求) : void
}
class "技工所接口" as EXT <<boundary>> #DDF0F2 {
  --
  + 提供订单(订单副本) : void
  + 接收技工所回执(回执) : void
}
UI .right.> CTRL
CTRL .right.> EXT
class "产品" as product <<entity>> #FFFFFF {
  - 名称、材料、单位 : string
  - 是否有效 : bool
  --
  + 校验适用(修复要求) : bool
}
class "技工所" as lab <<entity>> #FFFFFF {
  - 名称、联系方式 : string
  - 是否合作 : bool
  --
  + 确认可委托() : bool
}
class "义齿订单" as order <<entity>> #FFFFFF {
  - 颜色、盒色 : string
  - 数量 : decimal
  - 承诺日期 : Date
  - 当前阶段 : 订单阶段
  - 预计完成时间 : DateTime [0..1]
  --
  + 保存草稿(修复要求) : void
  + 发送() : 订单副本
  + 确认发送结果(结果) : void
  + 受理回执(回执) : 回执结果
  + 登记试戴(结论) : void
  + 确认交货() : void
  + 申请返工(原因) : void
  + 汇总交付(期间) : 统计结果
  + 列出待处理(期间) : 订单[*]
}
class "订单进展" as event <<entity>> #FFFFFF {
  - 发生时间 : DateTime
  - 原阶段、新阶段 : 订单阶段
  - 来源、事件号、原因 : string
  --
  + 记载进展(变更内容) : void
}
class "订单牙位" as tooth <<entity>> #FFFFFF {
  - 牙位编码 : string
  --
  + 核对牙位() : void
}
class "提醒" as reminder <<entity>> #FFFFFF {
  - 类型、收件人 : string
  - 计划时间 : DateTime
  - 发送结果 : string
  - 发送时间 : DateTime [0..1]
  --
  + 排定(目标、时间、收件人) : void
  + 按承诺日期排定() : void
  + 判断到期(当前时间) : bool
  + 确认发送(发送结果) : void
}
class "诊疗" as encounter <<entity>> #FFFFFF {
  - 发生时间 : DateTime
  --
  + 确认可开单() : bool
}
order "0..*" -[norank]- "1" product
order "0..*" -[norank]- "1" lab
order "1" *-right- "1..*" event
order "1" *-[norank]- "0..*" tooth
order "1" -[norank]- "0..*" reminder
CTRL .[norank].> order
encounter "1" -right- "0..*" order
CTRL .[norank].> encounter
UI -[hidden]right- CTRL
CTRL -[hidden]right- EXT
encounter -[hidden]right- order
order -[hidden]right- event
lab -[hidden]right- product
product -[hidden]right- tooth
tooth -[hidden]right- reminder
UI -[hidden]down- encounter
encounter -[hidden]down- lab
@enduml
