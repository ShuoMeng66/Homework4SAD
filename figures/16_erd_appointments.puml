@startuml
!include _style.puml
hide circle
hide empty methods
skinparam defaultFontSize 16
skinparam ClassFontSize 19
skinparam ClassAttributeFontSize 15
skinparam ArrowFontSize 13
skinparam nodesep 40
skinparam ranksep 65
skinparam linetype ortho
top to bottom direction
entity "clinic\n诊所资料" as clinic #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [UK] clinic_code : VARCHAR(32)
  {field} name : VARCHAR(120)
  {field} address : VARCHAR(240) ?
  {field} phone : VARCHAR(32) ?
  {field} active : BOOLEAN
  {field} created_at : TIMESTAMP
  {field} updated_at : TIMESTAMP
}
entity "clinic_room\n诊室" as clinic_room #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [FK] clinic_id : BIGINT → clinic.id
  {field} [UK] room_code : VARCHAR(24)
  {field} name : VARCHAR(60)
  {field} floor_note : VARCHAR(80) ?
  {field} active : BOOLEAN
}
entity "employee\n员工" as employee #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [FK] clinic_id : BIGINT → clinic.id
  {field} [UK] employee_no : VARCHAR(32)
  {field} name : VARCHAR(80)
  {field} phone : VARCHAR(32) ?
  {field} active : BOOLEAN
  {field} joined_on : DATE ?
  {field} left_on : DATE ?
}
entity "employee_role\n员工兼岗" as employee_role #FFFFFF {
  {field} [PK,FK] employee_id : BIGINT → employee.id
  {field} [PK,FK] role_id : BIGINT → basic_option.id
  {field} assigned_at : TIMESTAMP
  {field} revoked_at : TIMESTAMP ?
}
entity "basic_option\n分类基础选项" as basic_option #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [UK*] kind : VARCHAR(24)
  {field} [UK*] code : VARCHAR(32)
  {field} name : VARCHAR(80)
  {field} sort_order : INTEGER
  {field} active : BOOLEAN
  {field} description : VARCHAR(240) ?
}
entity "patient\n患者档案" as patient #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [UK] patient_no : VARCHAR(32)
  {field} name : VARCHAR(80)
  {field} birth_date : DATE ?
  {field} phone : VARCHAR(32) ?
  {field} contact_name : VARCHAR(80) ?
  {field} contact_phone : VARCHAR(32) ?
  {field} important_note : TEXT ?
  {field} [FK] created_by : BIGINT → employee.id
  {field} created_at : TIMESTAMP
  {field} updated_at : TIMESTAMP
}
entity "appointment\n诊疗预约" as appointment #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [UK] appointment_no : VARCHAR(32)
  {field} [FK] patient_id : BIGINT → patient.id
  {field} [FK] doctor_id : BIGINT → employee.id
  {field} [FK] room_id : BIGINT → clinic_room.id
  {field} [FK] type_id : BIGINT → basic_option.id
  {field} [FK] created_by : BIGINT → employee.id
  {field} chief_complaint : TEXT ?
  {field} starts_at : TIMESTAMP
  {field} ends_at : TIMESTAMP
  {field} stage : VARCHAR(24)
  {field} created_at : TIMESTAMP
  {field} confirmed_at : TIMESTAMP ?
  {field} arrived_at : TIMESTAMP ?
  {field} completed_at : TIMESTAMP ?
  {field} cancelled_at : TIMESTAMP ?
  {field} cancel_reason : TEXT ?
}
entity "appointment_event\n预约变更历史" as appointment_event #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [FK] appointment_id : BIGINT → appointment.id
  {field} [FK] changed_by : BIGINT → employee.id
  {field} old_start : TIMESTAMP ?
  {field} new_start : TIMESTAMP ?
  {field} old_end : TIMESTAMP ?
  {field} new_end : TIMESTAMP ?
  {field} old_stage : VARCHAR(24)
  {field} new_stage : VARCHAR(24)
  {field} reason : TEXT ?
  {field} occurred_at : TIMESTAMP
}
entity "encounter\n诊疗记录" as encounter #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [UK] encounter_no : VARCHAR(32)
  {field} [FK] patient_id : BIGINT → patient.id
  {field} [FK] clinic_id : BIGINT → clinic.id
  {field} [FK] doctor_id : BIGINT → employee.id
  {field} [FK,UK] appointment_id : BIGINT ? → appointment.id
  {field} occurred_at : TIMESTAMP
  {field} chief_complaint : TEXT
  {field} diagnosis : TEXT ?
  {field} treatment_note : TEXT ?
  {field} completed_at : TIMESTAMP ?
  {field} created_at : TIMESTAMP
}
clinic_room -[norank,#6B7280]-> clinic
employee -[norank,#6B7280]-> clinic
employee_role -[norank,#6B7280]-> employee
employee_role -[norank,#6B7280]-> basic_option
patient -[norank,#6B7280]-> employee
appointment -[norank,#6B7280]-> patient
appointment -[norank,#6B7280]-> employee
appointment -[norank,#6B7280]-> clinic_room
appointment -[norank,#6B7280]-> basic_option
appointment_event -[norank,#6B7280]-> appointment
appointment_event -[norank,#6B7280]-> employee
encounter -[norank,#6B7280]-> patient
encounter -[norank,#6B7280]-> clinic
encounter -[norank,#6B7280]-> employee
encounter -[norank,#6B7280]-> appointment
clinic -[hidden]right- employee
employee -[hidden]right- employee_role
clinic_room -[hidden]right- patient
patient -[hidden]right- basic_option
appointment -[hidden]right- encounter
encounter -[hidden]right- appointment_event
clinic -[hidden]down- clinic_room
clinic_room -[hidden]down- appointment
legend bottom left
PK：主键   FK：外键   UK：唯一   UK*：联合唯一   ?：可空
箭头：外键所在表 → 被引用表；逐字段引用目标见表内。
endlegend
@enduml
