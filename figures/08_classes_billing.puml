@startuml
!include _style.puml
hide circle
skinparam linetype polyline
skinparam nodesep 40
skinparam ranksep 60
class "收费接口" as UI <<boundary>> #DDF0F2 {
  --
  + 接收请求(输入) : void
  + 反馈结果(结果) : void
}
class "录入收费控制" as CTRL <<control>> #E5EFE2 {
  --
  + 录入收费(诊疗、项目) : void
}
class "支付服务接口" as EXT <<boundary>> #DDF0F2 {
  --
  + 发起支付(请求号、金额) : void
  + 接收支付结果(回执) : void
}
UI .right.> CTRL
CTRL .right.> EXT
class "诊疗" as encounter <<entity>> #FFFFFF {
  - 发生时间 : DateTime
  - 主诉、诊断 : string
  --
  + 开立收费单(项目集合) : 收费单
}
class "收费单" as bill <<entity>> #FFFFFF {
  - 开单时间 : DateTime
  - 合法折扣 : decimal
  - /应收、/已收、/欠款 : decimal
  --
  + 拟定(诊疗、项目集合) : 收费单
  + 计算应收() : decimal
  + 应用支付结果(支付、结果) : void
  + 汇总回收(期间) : 统计结果
}
class "收费项目" as price <<entity>> #FFFFFF {
  - 名称、单位 : string
  - 当前单价 : decimal
  - 是否有效 : bool
  --
  + 确认可收费() : bool
  + 给出计价依据() : decimal
}
class "收费明细" as line <<entity>> #FFFFFF {
  - 项目名称、单位 : string
  - 数量 : decimal
  - 成交单价、项目折扣 : decimal
  --
  + 计算行金额() : decimal
}
class "支付" as payment <<entity>> #FFFFFF {
  - 请求号、外部交易号 : string
  - 金额 : decimal
  - 发生时间 : DateTime
  - 当前结果 : 支付结果
  --
  + 登记尝试(金额、请求号) : void
  + 确认结果(回执) : void
  + 给出有效入账额() : decimal
}
class "欠款" as debt <<entity>> #FFFFFF {
  - 形成日期、到期日 : Date
  - 结清时间 : DateTime [0..1]
  - /余额 : decimal
  --
  + 复核余额(收费单) : void
  + 登记结清() : void
}
encounter "1" -right- "0..*" bill
bill "1" *-right- "1..*" line
line "0..*" -[norank]- "1" price
bill "1" *-[norank]- "0..*" payment
bill "1" -[norank]- "0..1" debt
CTRL .[norank].> bill
UI -[hidden]right- CTRL
CTRL -[hidden]right- EXT
encounter -[hidden]right- bill
bill -[hidden]right- line
payment -[hidden]right- debt
debt -[hidden]right- price
UI -[hidden]down- encounter
encounter -[hidden]down- payment
@enduml
