@startuml
!include _style.puml
hide circle
hide empty members
skinparam ClassFontSize 20
skinparam ArrowFontSize 16
class "用例" as UC
class "执行者" as Actor
class "主执行者" as Primary
class "辅执行者" as Secondary
class "涉众" as Stakeholder
class "涉众利益" as Interest
class "前置条件" as Pre
class "后置条件" as Post
class "路径" as Path
class "基本路径" as Basic
class "扩展路径" as Extension
class "步骤" as Step
abstract class "补充约束" as Constraint
class "字段列表" as Fields
class "业务规则" as Rules
class "质量需求" as Quality
class "设计约束" as Design
Primary -up-|> Actor
Secondary -up-|> Actor
Actor -- UC : 参与
Stakeholder "1" -- "1..*" Interest
Interest -- UC : 关注
UC -- Pre
UC -- Post
UC "1" *-- "1..*" Path
Basic -up-|> Path
Extension -up-|> Path
Path "1" *-- "1..*" Step
UC "1" *-- "0..*" Constraint
Fields -up-|> Constraint
Rules -up-|> Constraint
Quality -up-|> Constraint
Design -up-|> Constraint
@enduml
