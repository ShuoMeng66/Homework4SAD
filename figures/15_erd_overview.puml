@startuml
!include _style.puml
hide circle
hide empty methods
skinparam defaultFontSize 16
skinparam ClassFontSize 19
skinparam ClassAttributeFontSize 15
skinparam ArrowFontSize 13
skinparam nodesep 40
skinparam ranksep 65
skinparam linetype ortho
top to bottom direction
package "诊所、岗位与基础资料" as group_resources #E8EDF5 {
entity "clinic\n诊所资料" as clinic #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [UK] clinic_code : VARCHAR(32)
  {field} name : VARCHAR(120)
  {field} address : VARCHAR(240) ?
  {field} phone : VARCHAR(32) ?
  {field} active : BOOLEAN
  {field} created_at : TIMESTAMP
  {field} updated_at : TIMESTAMP
}
entity "clinic_room\n诊室" as clinic_room #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [FK] clinic_id : BIGINT → clinic.id
  {field} [UK] room_code : VARCHAR(24)
  {field} name : VARCHAR(60)
  {field} floor_note : VARCHAR(80) ?
  {field} active : BOOLEAN
}
entity "employee\n员工" as employee #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [FK] clinic_id : BIGINT → clinic.id
  {field} [UK] employee_no : VARCHAR(32)
  {field} name : VARCHAR(80)
  {field} phone : VARCHAR(32) ?
  {field} active : BOOLEAN
  {field} joined_on : DATE ?
  {field} left_on : DATE ?
}
entity "employee_role\n员工兼岗" as employee_role #FFFFFF {
  {field} [PK,FK] employee_id : BIGINT → employee.id
  {field} [PK,FK] role_id : BIGINT → basic_option.id
  {field} assigned_at : TIMESTAMP
  {field} revoked_at : TIMESTAMP ?
}
entity "basic_option\n分类基础选项" as basic_option #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [UK*] kind : VARCHAR(24)
  {field} [UK*] code : VARCHAR(32)
  {field} name : VARCHAR(80)
  {field} sort_order : INTEGER
  {field} active : BOOLEAN
  {field} description : VARCHAR(240) ?
}
clinic -[hidden]right- clinic_room
clinic -[hidden]down- employee
employee -[hidden]right- employee_role
employee -[hidden]down- basic_option
}
package "患者、预约与诊疗" as group_patient #E3F0EE {
entity "patient\n患者档案" as patient #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [UK] patient_no : VARCHAR(32)
  {field} name : VARCHAR(80)
  {field} birth_date : DATE ?
  {field} phone : VARCHAR(32) ?
  {field} contact_name : VARCHAR(80) ?
  {field} contact_phone : VARCHAR(32) ?
  {field} important_note : TEXT ?
  {field} [FK] created_by : BIGINT → employee.id
  {field} created_at : TIMESTAMP
  {field} updated_at : TIMESTAMP
}
entity "appointment\n诊疗预约" as appointment #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [UK] appointment_no : VARCHAR(32)
  {field} [FK] patient_id : BIGINT → patient.id
  {field} [FK] doctor_id : BIGINT → employee.id
  {field} [FK] room_id : BIGINT → clinic_room.id
  {field} [FK] type_id : BIGINT → basic_option.id
  {field} [FK] created_by : BIGINT → employee.id
  {field} chief_complaint : TEXT ?
  {field} starts_at : TIMESTAMP
  {field} ends_at : TIMESTAMP
  {field} stage : VARCHAR(24)
  {field} created_at : TIMESTAMP
  {field} confirmed_at : TIMESTAMP ?
  {field} arrived_at : TIMESTAMP ?
  {field} completed_at : TIMESTAMP ?
  {field} cancelled_at : TIMESTAMP ?
  {field} cancel_reason : TEXT ?
}
entity "appointment_event\n预约变更历史" as appointment_event #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [FK] appointment_id : BIGINT → appointment.id
  {field} [FK] changed_by : BIGINT → employee.id
  {field} old_start : TIMESTAMP ?
  {field} new_start : TIMESTAMP ?
  {field} old_end : TIMESTAMP ?
  {field} new_end : TIMESTAMP ?
  {field} old_stage : VARCHAR(24)
  {field} new_stage : VARCHAR(24)
  {field} reason : TEXT ?
  {field} occurred_at : TIMESTAMP
}
entity "encounter\n诊疗记录" as encounter #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [UK] encounter_no : VARCHAR(32)
  {field} [FK] patient_id : BIGINT → patient.id
  {field} [FK] clinic_id : BIGINT → clinic.id
  {field} [FK] doctor_id : BIGINT → employee.id
  {field} [FK,UK] appointment_id : BIGINT ? → appointment.id
  {field} occurred_at : TIMESTAMP
  {field} chief_complaint : TEXT
  {field} diagnosis : TEXT ?
  {field} treatment_note : TEXT ?
  {field} completed_at : TIMESTAMP ?
  {field} created_at : TIMESTAMP
}
patient -[hidden]right- appointment
patient -[hidden]down- appointment_event
appointment_event -[hidden]right- encounter
}
package "收费明细、支付与催收" as group_billing #F7ECD7 {
entity "price_item\n收费价目" as price_item #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [UK] item_code : VARCHAR(32)
  {field} name : VARCHAR(80)
  {field} [FK] unit_id : BIGINT → basic_option.id
  {field} unit_price : DECIMAL(12,2)
  {field} active : BOOLEAN
  {field} updated_at : TIMESTAMP
}
entity "bill\n收费单与催收" as bill #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [UK] bill_no : VARCHAR(32)
  {field} [FK] encounter_id : BIGINT → encounter.id
  {field} [FK] issued_by : BIGINT → employee.id
  {field} discount_amount : DECIMAL(12,2)
  {field} discount_reason : TEXT ?
  {field} issued_at : TIMESTAMP
  {field} due_date : DATE ?
  {field} debt_opened_at : TIMESTAMP ?
  {field} settled_at : TIMESTAMP ?
  {field} collection_note : TEXT ?
  {field} stage : VARCHAR(24)
  {field} voided_at : TIMESTAMP ?
  {field} void_reason : TEXT ?
}
entity "bill_line\n收费项目明细" as bill_line #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [FK,UK*] bill_id : BIGINT → bill.id
  {field} [UK*] line_no : INTEGER
  {field} [FK] price_item_id : BIGINT → price_item.id
  {field} [FK] dental_order_id : BIGINT ? → dental_order.id
  {field} item_name : VARCHAR(80)
  {field} unit : VARCHAR(24)
  {field} quantity : DECIMAL(10,2)
  {field} unit_price : DECIMAL(12,2)
  {field} discount_amount : DECIMAL(12,2)
  {field} description : VARCHAR(240) ?
}
entity "payment\n收款退款与支付尝试" as payment #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [FK] bill_id : BIGINT → bill.id
  {field} [UK] request_no : VARCHAR(64)
  {field} [UK] external_txn_no : VARCHAR(96) ?
  {field} [FK] method_id : BIGINT → basic_option.id
  {field} [FK] refund_of_id : BIGINT ? → payment.id
  {field} kind : VARCHAR(24)
  {field} result : VARCHAR(24)
  {field} amount : DECIMAL(12,2)
  {field} requested_at : TIMESTAMP
  {field} occurred_at : TIMESTAMP ?
  {field} failure_reason : TEXT ?
  {field} checked_at : TIMESTAMP ?
}
price_item -[hidden]right- bill
price_item -[hidden]down- bill_line
bill_line -[hidden]right- payment
}
package "义齿委托、交付与通知" as group_order #ECE5F4 {
entity "product\n义齿产品" as product #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [UK] product_code : VARCHAR(32)
  {field} name : VARCHAR(80)
  {field} material : VARCHAR(80)
  {field} [FK] unit_id : BIGINT → basic_option.id
  {field} specification : VARCHAR(240) ?
  {field} requires_attachment : BOOLEAN
  {field} active : BOOLEAN
}
entity "dental_lab\n合作技工所" as dental_lab #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [UK] lab_code : VARCHAR(32)
  {field} name : VARCHAR(120)
  {field} contact : VARCHAR(80)
  {field} phone : VARCHAR(32)
  {field} address : VARCHAR(240) ?
  {field} interface_code : VARCHAR(64) ?
  {field} active : BOOLEAN
}
entity "dental_order\n义齿委托订单" as dental_order #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [UK] order_no : VARCHAR(32)
  {field} [FK] encounter_id : BIGINT → encounter.id
  {field} [FK] product_id : BIGINT → product.id
  {field} [FK] lab_id : BIGINT → dental_lab.id
  {field} [FK] created_by : BIGINT → employee.id
  {field} [FK] color_id : BIGINT → basic_option.id
  {field} [FK] box_color_id : BIGINT ? → basic_option.id
  {field} [FK] type_id : BIGINT → basic_option.id
  {field} [FK] unit_id : BIGINT → basic_option.id
  {field} quantity : DECIMAL(10,2)
  {field} repair_requirement : TEXT
  {field} promised_date : DATE
  {field} stage : VARCHAR(24)
  {field} dispatch_result : VARCHAR(24)
  {field} expected_at : TIMESTAMP ?
  {field} created_at : TIMESTAMP
  {field} sent_at : TIMESTAMP ?
  {field} accepted_at : TIMESTAMP ?
  {field} trial_at : TIMESTAMP ?
  {field} trial_result : VARCHAR(24) ?
  {field} delivered_at : TIMESTAMP ?
  {field} cancelled_at : TIMESTAMP ?
  {field} cancel_reason : TEXT ?
}
entity "order_tooth\n订单牙位" as order_tooth #FFFFFF {
  {field} [PK,FK] order_id : BIGINT → dental_order.id
  {field} [PK] tooth_code : VARCHAR(8)
  {field} repair_note : VARCHAR(240) ?
}
entity "order_event\n技工所回执与进展" as order_event #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [FK,UK*] order_id : BIGINT → dental_order.id
  {field} [UK*] source : VARCHAR(64)
  {field} [UK*] event_no : VARCHAR(64)
  {field} [FK] changed_by : BIGINT ? → employee.id
  {field} old_stage : VARCHAR(24)
  {field} new_stage : VARCHAR(24)
  {field} reason : TEXT ?
  {field} external_order_no : VARCHAR(64) ?
  {field} occurred_at : TIMESTAMP
  {field} received_at : TIMESTAMP
}
entity "order_attachment\n修复附件" as order_attachment #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [FK] order_id : BIGINT → dental_order.id
  {field} [FK] type_id : BIGINT → basic_option.id
  {field} [FK] uploaded_by : BIGINT → employee.id
  {field} file_name : VARCHAR(180)
  {field} [UK] storage_key : VARCHAR(240)
  {field} mime_type : VARCHAR(80)
  {field} byte_size : BIGINT
  {field} checksum : VARCHAR(64) ?
  {field} uploaded_at : TIMESTAMP
}
entity "reminder\n预约与订单通知" as reminder #FFFFFF {
  {field} [PK] id : BIGINT
  {field} [FK,UK*] order_id : BIGINT ? → dental_order.id
  {field} [FK,UK*] appointment_id : BIGINT ? → appointment.id
  {field} [FK] channel_id : BIGINT → basic_option.id
  {field} [FK] created_by : BIGINT → employee.id
  {field} [UK*] kind : VARCHAR(24)
  {field} [UK*] scheduled_at : TIMESTAMP
  {field} [UK*] recipient : VARCHAR(120)
  {field} content : TEXT
  {field} delivery_result : VARCHAR(24)
  {field} attempt_count : INTEGER
  {field} last_attempt_at : TIMESTAMP ?
  {field} sent_at : TIMESTAMP ?
  {field} failure_reason : TEXT ?
}
