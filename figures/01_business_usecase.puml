@startuml
!include _style.puml
left to right direction
skinparam nodesep 45
skinparam ranksep 50
actor/ "患者" as patient
actor/ "支付机构" as payment
actor/ "合作义齿技工所" as lab
rectangle "口腔诊所" {
  usecase/ "口腔诊疗" as care
  usecase/ "预约复诊" as appointment
  usecase/ "费用结算" as billing
  usecase/ "义齿交付" as delivery
  care -[hidden]right-> appointment
  appointment -[hidden]right-> billing
  billing -[hidden]right-> delivery
}
patient --> care
patient --> appointment
patient --> billing
patient --> delivery
billing --> payment
delivery --> lab
payment -[hidden]right-> lab
@enduml
